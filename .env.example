# Copy to .env. Values below are LOCAL DEV ONLY. Change every secret for any real deployment.

# --- Gateway ---
GATEWAY_PORT=80                 # host port for nginx gateway

# --- PostgreSQL (Neon) ---
# DATABASE_URL: pooled connection (host contains -pooler), used by the api and worker at runtime.
# DIRECT_URL:   direct connection, used only by `prisma migrate deploy`.
# Both come from the Neon dashboard > Connect. Append ?sslmode=require. Leave blank to use the local compose postgres.
DATABASE_URL=
DIRECT_URL=
# local compose database, for reference:
# DATABASE_URL=postgresql://learnly:learnly@localhost:5434/learnly

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- S3 (MinIO locally; set real AWS values to swap) ---
S3_ENDPOINT=http://minio:9000                 # internal, used by api/worker
S3_PUBLIC_ENDPOINT=http://localhost:9010      # used when signing URLs for the browser
S3_REGION=us-east-1
S3_ACCESS_KEY=learnly
S3_SECRET_KEY=learnly-dev-secret-change-me
S3_FORCE_PATH_STYLE=true
S3_BUCKET_UPLOADS=learnly-uploads
S3_BUCKET_MEDIA=learnly-media
S3_BUCKET_PRIVATE=learnly-private

# --- CDN (nginx secure_link simulates CloudFront signed URLs) ---
CDN_SIGNER=nginx                              # nginx | cloudfront
CDN_SECRET=cdn-dev-secret-change-me           # HMAC secret shared by api and cdn
CDN_PUBLIC_PATH=/cdn
CDN_URL_TTL_SECONDS=900

# --- Mail (Mailpit) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Auth ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- LiveKit (fixed dev key pair; MUST change in production) ---
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost/rtc
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-0123456789

# --- Worker ---
WORKER_CONCURRENCY=1            # parallel transcodes; the worker also accepts the older name FFMPEG_CONCURRENCY
# MAIL_FROM="Learnly <no-reply@learnly.local>"   # From: header of every email (api and worker)
# LOG_LEVEL=info                                 # pino level for api and worker: debug | info | warn | error

# --- Payments (test mode only; live keys are refused) ---
PAYMENT_PROVIDER=mock                         # mock | stripe | paystack
STRIPE_SECRET_KEY=                            # sk_test_...
STRIPE_WEBHOOK_SECRET=                        # whsec_... from `stripe listen` or the dashboard endpoint (POST /api/payments/webhook)
PAYSTACK_SECRET_KEY=                          # sk_test_... (Paystack, for countries Stripe does not serve). Webhook: POST /api/payments/webhook
PAYMENT_CURRENCY=usd                          # NGN for Paystack
PLATFORM_FEE_BPS=1000                         # 10% platform share, in basis points; the instructor earns the rest
ALLOW_MOCK_PAYMENTS=                          # set to 1 ONLY to let PAYMENT_PROVIDER=mock run with NODE_ENV=production (demo deployments)

# --- CloudFront (only when CDN_SIGNER=cloudfront) ---
CDN_CF_DOMAIN=                                # dxxxx.cloudfront.net
CDN_CF_KEY_PAIR_ID=
CDN_CF_PRIVATE_KEY=                           # PEM, newlines as \n
CDN_COOKIE_DOMAIN=

# --- LiveKit Cloud (optional, replaces the local livekit container) ---
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_PUBLIC_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- Public URLs ---
# WEB_ORIGIN: browser origin only (no path). Used for CORS and socket.io; localhost origins are added only when NODE_ENV != production.
WEB_ORIGIN=http://localhost
# WEB_BASE_URL: public origin + base path, used in links the API sends out (payment return URL, password-reset email).
# Example for a deployment under a sub-path: https://example.com/learnly-js . Falls back to WEB_ORIGIN when empty.
WEB_BASE_URL=

# --- API tuning ---
API_RATE_LIMIT=300                            # requests per minute per IP across /api

# --- Web (build-time) ---
# NEXT_BASE_PATH / NEXT_PUBLIC_BASE_PATH: sub-path the web app is served under (either name works); empty at the site root.
# NEXT_PUBLIC_DEMO_LOGINS=1 shows the demo-credential buttons on /login. Leave unset in production.
# NEXT_PUBLIC_DEMO_LOGINS=

