{
  "name": "learnly",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "seed": "tsx scripts/seed.ts",
    "test": "pnpm -r --if-present test",
    "s3:smoke": "node scripts/s3-smoke.mjs",
    "video:sample": "node scripts/video-sample.mjs",
    "test:visual": "playwright test",
    "db:migrate": "pnpm --filter @learnly/db migrate"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "@playwright/test": "^1.48.0",
    "@learnly/db": "workspace:*",
    "bcryptjs": "^2.4.3"
  }
}
